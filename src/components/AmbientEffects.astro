<canvas id="ambient-field" aria-hidden="true"></canvas>
<div id="cursor-halo" aria-hidden="true"></div>
<div id="reading-progress" aria-hidden="true"></div>
<button id="motion-toggle" type="button" aria-pressed="false" title="开启或关闭装饰动效">
  <span aria-hidden="true">✧</span><span id="motion-label">动效</span>
</button>

<style is:global>
  #ambient-field { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; opacity: .55; background: radial-gradient(ellipse at 0% 30%, #87d4c514, transparent 45%), radial-gradient(ellipse at 100% 80%, #e1c79814, transparent 40%); }
  #cursor-halo { position: fixed; top: 0; left: 0; width: 34px; height: 34px; border: 1px solid rgba(44, 153, 153, .65); background: radial-gradient(circle, rgba(139, 226, 214, .18), transparent); border-radius: 50%; pointer-events: none; z-index: 9998; opacity: 0; transition: width .2s, height .2s, opacity .2s, background .2s; }
  #cursor-halo.over-link { width: 54px; height: 54px; background: rgba(139, 226, 214, .16); }
  #reading-progress { position: fixed; inset: 0 0 auto; height: 3px; z-index: 9999; pointer-events: none; transform-origin: left; transform: scaleX(0); background: linear-gradient(90deg, #418d99, #9cddbf, #eac68d); }
  #motion-toggle { position: fixed; right: 1.2rem; bottom: 6.5rem; z-index: 60; display: flex; align-items: center; gap: .5rem; padding: .6rem .85rem; border: 1px solid rgba(110,155,156,.3); border-radius: 99px; background: rgba(247,252,249,.9); color: #27535b; box-shadow: 0 8px 30px #203b4912; backdrop-filter: blur(12px); font-size: .75rem; }
  #motion-toggle > span:first-child { font-size: 1.3rem; line-height: 1; }
  #motion-toggle:focus-visible { outline: 2px solid #418d99; outline-offset: 4px; }
  .dark #motion-toggle { background: #172e35e6; color: #b3e4d6; }
  .click-ripple { position: fixed; width: 12px; height: 12px; border: 1px solid #76baa9; border-radius: 50%; pointer-events: none; z-index: 9997; animation: ripple-out .65s ease-out forwards; }
  @keyframes ripple-out { from { transform: translate(-50%, -50%) scale(1); opacity: .8; } to { transform: translate(-50%, -50%) scale(7); opacity: 0; } }
  [data-glow-card] { position: relative; isolation: isolate; overflow: hidden; transition: border-color .3s, box-shadow .3s; }
  [data-glow-card]::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: 0; background: radial-gradient(360px circle at var(--glow-x,50%) var(--glow-y,50%), #c1ebdf80, transparent 70%); transition: opacity .35s; }
  [data-glow-card]:hover::after { opacity: 1; }
  [data-glow-card]:hover { border-color: #8dbfb3; box-shadow: 0 20px 60px #326a681a; }
  html[data-motion="off"] #ambient-field, html[data-motion="off"] #cursor-halo { display: none; }
  html[data-motion="off"] [data-glow-card]::after { display: none; }
  html[data-motion="off"] .hero-title-animation, html[data-motion="off"] .hero-subtitle-animation, html[data-motion="off"] .onload-animation { animation: none !important; opacity: 1 !important; transform: none !important; }
  @media (hover: none), (pointer: coarse) { #cursor-halo, #ambient-field { display: none; } #motion-toggle { bottom: 5.5rem; } }
  @media (prefers-reduced-motion: reduce) {
    #cursor-halo, #ambient-field, .click-ripple { display: none; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#ambient-field')!;
  const ctx = canvas.getContext('2d');
  const halo = document.querySelector<HTMLElement>('#cursor-halo')!;
  const toggle = document.querySelector<HTMLButtonElement>('#motion-toggle')!;
  const label = document.querySelector<HTMLElement>('#motion-label')!;
  const progress = document.querySelector<HTMLElement>('#reading-progress')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  let enabled = true;
  try { enabled = localStorage.getItem('blog-motion') !== 'off'; } catch { /* Storage can be unavailable in private browsing. */ }
  let frame = 0, width = innerWidth, height = innerHeight;
  let pointerX = -1000, pointerY = -1000, haloX = -1000, haloY = -1000;
  let lastTime = 0;
  const dots = Array.from({ length: 28 }, (_, i) => ({
    x: ((i * .61803398875) % 1), y: ((i * .381966 + .2) % 1),
    speed: .000008 + (i % 4) * .000003,
  }));
  const active = () => enabled && !reduced.matches && fine.matches && !document.hidden;
  function resize() {
    width = innerWidth; height = innerHeight;
    const ratio = Math.min(devicePixelRatio, 1.5);
    canvas.width = width * ratio; canvas.height = height * ratio;
    ctx?.setTransform(ratio, 0, 0, ratio, 0, 0);
  }
  function draw(time: number) {
    frame = 0;
    if (reduced.matches) { sync(); return; }
    if (!active() || !ctx) return;
    const dt = Math.min(time - lastTime || 16, 40);
    lastTime = time;
    ctx.clearRect(0, 0, width, height);
    ctx.strokeStyle = 'rgba(88, 155, 154, .20)';
    ctx.fillStyle = document.documentElement.classList.contains('dark') ? '#8ecbbd' : '#609e99';
    const points = dots.map((dot, i) => {
      dot.y = (dot.y - dot.speed * dt + 1) % 1;
      return { x: dot.x * width + Math.sin(time * .00015 + i) * 20, y: dot.y * height };
    });
    for (const [i, p] of points.entries()) {
      ctx.beginPath(); ctx.arc(p.x, p.y, i % 3 === 0 ? 2 : 1, 0, Math.PI * 2); ctx.fill();
      if (Math.hypot(p.x - pointerX, p.y - pointerY) < 160) {
        ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(pointerX, pointerY); ctx.stroke();
      }
      for (let j = i + 1; j < points.length; j++) {
        const next = points[j];
        if (Math.hypot(p.x - next.x, p.y - next.y) < 125) {
          ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(next.x, next.y); ctx.stroke();
        }
      }
    }
    haloX += (pointerX - haloX) * .2; haloY += (pointerY - haloY) * .2;
    halo.style.transform = `translate3d(${haloX}px, ${haloY}px, 0) translate(-50%, -50%)`;
    frame = requestAnimationFrame(draw);
  }
  function sync() {
    const on = enabled && !reduced.matches;
    document.documentElement.dataset.motion = on ? 'on' : 'off';
    toggle.setAttribute('aria-pressed', String(on));
    toggle.disabled = reduced.matches;
    label.textContent = reduced.matches ? '静态模式' : on ? '动效开' : '动效关';
    if (frame) cancelAnimationFrame(frame);
    frame = 0; lastTime = 0;
    if (active()) frame = requestAnimationFrame(draw);
    else { ctx?.clearRect(0, 0, width, height); halo.style.opacity = '0'; }
  }
  toggle.addEventListener('click', () => {
    enabled = !enabled;
    try { localStorage.setItem('blog-motion', enabled ? 'on' : 'off'); } catch { /* Keep the session preference even without storage. */ }
    sync();
  });
  document.addEventListener('pointermove', event => {
    if (!active()) return;
    if (pointerX === -1000) { haloX = event.clientX; haloY = event.clientY; }
    pointerX = event.clientX; pointerY = event.clientY;
    halo.style.opacity = '1';
    const target = event.target instanceof Element ? event.target : null;
    halo.classList.toggle('over-link', !!target?.closest('a,button,input,summary'));
    const card = target?.closest<HTMLElement>('[data-glow-card]');
    if (card) {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--glow-x', `${event.clientX - rect.left}px`);
      card.style.setProperty('--glow-y', `${event.clientY - rect.top}px`);
    }
  }, { passive: true });
  document.documentElement.addEventListener('pointerleave', () => { pointerX = pointerY = -1000; halo.style.opacity = '0'; });
  document.addEventListener('click', event => {
    if (!active() || event.detail === 0 || document.querySelectorAll('.click-ripple').length >= 6) return;
    const ripple = document.createElement('div');
    ripple.className = 'click-ripple'; ripple.setAttribute('aria-hidden', 'true');
    ripple.style.left = `${event.clientX}px`; ripple.style.top = `${event.clientY}px`;
    document.body.append(ripple);
    setTimeout(() => ripple.remove(), 700);
  });
  function updateProgress() {
    const total = document.documentElement.scrollHeight - innerHeight;
    progress.style.transform = `scaleX(${total > 0 ? Math.min(1, Math.max(0, scrollY / total)) : 0})`;
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', () => { resize(); updateProgress(); });
  window.addEventListener('pageshow', sync);
  window.addEventListener('focus', sync);
  document.addEventListener('visibilitychange', sync);
  reduced.addEventListener('change', sync); fine.addEventListener('change', sync);
  resize(); sync(); updateProgress();
</script>
