{
  "name": "solskjaer-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Personal blog powered by Hexo and Butterfly",
  "scripts": {
    "dev": "node tools/prepare.mjs && hexo server",
    "build": "node tools/prepare.mjs && hexo clean && hexo generate && node tools/verify.mjs",
    "preview": "hexo server --static",
    "check": "node tools/verify.mjs",
    "test:browser": "node tools/browser-check.mjs",
    "new-post": "hexo new post"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.14.4",
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "hexo": "8.1.2",
    "hexo-util": "4.0.0",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-feed": "3.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-searchdb": "1.5.0",
    "hexo-generator-sitemap": "3.0.1",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-markdown-it": "7.1.1",
    "hexo-renderer-pug": "3.0.0",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0",
    "hexo-theme-butterfly": "5.7.0",
    "medium-zoom": "1.1.0",
    "moment-timezone": "0.6.4",
    "sharp": "0.34.5",
    "typed.js": "2.1.0"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
